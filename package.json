{
  "name": "@dsh-external/dsh-prompt-optimizer",
  "version": "0.2.0-beta.1",
  "description": "DSH Web 输入框接管：发送前用独立 AI（传话者）把提示词优化成可直接发给工作 AI 的命令（基于上游 0.1.9 功能 + 本 fork 的界面改造：入口合并为一枚胶囊、拦截卡贴在输入框上方）",
  "type": "module",
  "main": "./lib/index.js",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "ACCEPTANCE.md",
    "LICENSE",
    "CHANGELOG.md",
    "README.en.md",
    "ROADMAP.md",
    "PROMPT-OPTIMIZATION.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "prompt",
    "prompt-optimizer",
    "llm",
    "web"
  ],
  "license": "BSD-3-Clause",
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-client-ui-slots": "*",
    "cordis": "*",
    "@deepseek-ai/dsh-client-ui-primitives": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-slots": {
      "optional": true
    },
    "cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-primitives": {
      "optional": true
    }
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "platform": "web"
    }
  }
}
